    "react-dom": "19.2.7",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.1",
    "@playwright/test": "1.60.0",
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.27",
    "dotenv": "17.4.2",
